---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import type { SeoProps } from "@/types.ts";

import "@fontsource/ranchers";
import "@fontsource/manjari";
import "@fontsource/bayon";
import "@fontsource/barriecito";
import "@fontsource/allerta-stencil";
import "@fontsource/boogaloo";
import "@fontsource/delicious-handrawn";
import "@fontsource/thasadith";
import "@fontsource/delius-unicase";
import "@fontsource-variable/m-plus-1";
import "@fontsource-variable/reddit-sans";
import "@fontsource/bowlby-one-sc";
import "@fontsource/lilita-one";
import "@fontsource/alfa-slab-one";
import "@fontsource/architects-daughter";
import "@fontsource-variable/grandstander";
import "@fontsource/acme";
import "@fontsource/luckiest-guy";
import "@fontsource-variable/dosis";
import "@fontsource-variable/fredoka";
import "@fontsource-variable/urbanist";
import "@fontsource-variable/outfit";
import "@fontsource/momo-trust-display";
import "@fontsource-variable/stack-sans-notch";
import "@fontsource/averia-libre";
import "@fontsource/indie-flower";
import "@fontsource/zen-maru-gothic";
import "@fontsource-variable/red-hat-display";
import "@fontsource/bangers";
import "@fontsource-variable/figtree";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
.font-ranchers {
  font-family: "Ranchers";
}

.font-manjari {
  font-family: "Manjari";
}


---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import { IconArrowRight } from "@tabler/icons-astro";

import { getPublishedPosts, postCard } from "@/utils/blog";

type Post = {
  title: string;
  href: string;
  category: string;
  date: string;
  dateLabel: string;
  excerpt: string;
  image: string;
  imageAlt: string;
  author: string;
  authorImage?: string | null;
  initials?: string;
  readTime: string;
};
type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  HTMLAttributes<"section"> & {
    /** Heading text. */
    heading?: string;
    /** Heading level. */
    headingTag?: ComponentProps<typeof Heading>["tag"];
    /** Introductory text. */
    description?: string;
    /** Blog posts, with the first post featured. */
    posts?: Post[];
    /** All articles link label. */
    allArticlesText?: string;
    /** All articles link destination. */
    allArticlesHref?: string;
  };
const {
  render = true,
  heading = "writing",
  headingTag = "h2",
  description = "Notes on systems, agents and the craft of building software. Mostly Rust, Erlang and Go.",
  posts = (await getPublishedPosts()).slice(0, 4).map(postCard) as Post[],
  allArticlesText = "Read all posts",
  allArticlesHref = "/blog/",
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  id,
  class: className,
  ...rest
} = Astro.props;
const headingId = `${id ?? `blog-cards-${crypto.randomUUID()}`}-title`;
const visiblePosts = posts.filter(
  (post) => post.title.trim() && post.href.trim(),
);
const ItemHeading =
  `h${Math.min(Number(headingTag.slice(1)) + 1, 6)}` as NonNullable<
    ComponentProps<typeof Heading>["tag"]
  >;
---

<Section
  render={render && visiblePosts.length > 0}
  {theme}
  {paddingTop}
  {paddingBottom}
  {id}
  class={className}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="blog-cards_header">
    <div class="blog-cards_intro">
      <ContentWrapper>
        <Heading
          tag={headingTag}
          variant="h2"
          id={headingId}
          class="heading-label"
        >
          {heading}
        </Heading>
        <Paragraph
          render={Boolean(description.trim())}
          variant="h4"
          maxWidth={44}
          class="font-figtree margin-top-6"
        >
          {description}
        </Paragraph>
      </ContentWrapper>
    </div>
  </div>
  <ul class="blog-cards_list" role="list">
    {visiblePosts.map((post, index) => (
      <li class:list={["blog-cards_item", index === 0 && "featured"]}>
        <article class="blog-cards_card">
          {post.image && (
            <div class="blog-cards_stage">
              <img
                class="blog-cards_image"
                src={post.image}
                alt={post.imageAlt}
                width="672"
                height="448"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="blog-cards_content">
            <p class="blog-cards_meta text-style-small">
              <span class="blog-cards_category">{post.category}</span>
              <span aria-hidden="true">·</span>
              <time datetime={post.date}>{post.dateLabel}</time>
              <span aria-hidden="true">·</span>
              <span>{post.readTime}</span>
            </p>
            <ItemHeading class="blog-cards_title text-style-h5">
              <a href={post.href}>{post.title}</a>
            </ItemHeading>
            {post.excerpt.trim() && (
              <p class="blog-cards_excerpt text-style-small">
                {post.excerpt}
              </p>
            )}
          </div>
        </article>
      </li>
    ))}
  </ul>
  {allArticlesText.trim() && allArticlesHref.trim() && (
    <div class="blog-cards_footer">
      <Button element="link" variant="link" href={allArticlesHref}>
        <span class="blog-cards_action">
          {allArticlesText}
          <IconArrowRight size="1em" stroke={1.75} />
        </span>
      </Button>
    </div>
  )}
</Section>

<style is:global>
  @layer components {
    .blog-cards_intro {
      flex: 1 1 32rem;
      min-width: 0;
      max-width: 64ch;
    }
    .blog-cards_action {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
    }
    .blog-cards_header {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-4);
    }
    .blog-cards_list {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      padding: 0;
      margin: var(--space-6) 0 0;
      list-style: none;
      @media (width >= 64rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        .blog-cards_item.featured {
          grid-column: 1 / -1;
        }
      }
    }
    .blog-cards_item {
      container-type: inline-size;
      min-width: 0;
    }
    .blog-cards_footer {
      width: 100%;
      display: flex;
      justify-content: center;
      margin-top: var(--space-6);
    }
    .blog-cards_card {
      position: relative;
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--space-1);
      height: 100%;
      padding: var(--space-1);
      border-radius: calc(var(--radius-main) * 1.5);
      background: var(--color-white);
      border: var(--border-width) solid var(--color-black);
      box-shadow: 10px 10px 2px 1px rgba(18, 18, 18, 0.2);
      &:has(a:focus-visible) {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
      &:hover .blog-cards_title {
        text-decoration: underline;
      }
      @container (width >= 32rem) {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        grid-template-rows: 1fr;
        align-items: center;
      }
    }
    .blog-cards_stage {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-main);
      background: var(--background-2);
      border: var(--border-width) solid var(--border);
    }
    .blog-cards_image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .blog-cards_content {
      align-self: stretch;
      padding: var(--space-4);
      min-width: 0;
      max-width: 48rem;
      &:only-child {
        grid-column: 1 / -1;
      }
    }
    .blog-cards_meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
      margin: 0;
      color: var(--text-2);
      font-variant-numeric: tabular-nums;
    }
    .blog-cards_category {
      color: var(--text);
      font-weight: var(--primary-medium);
    }
    .blog-cards_title {
      margin: var(--space-3) 0 0;
      text-wrap: balance;
      text-underline-offset: 0.25em;
      & a {
        color: var(--text);
        text-decoration: none;
      }
      & a::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
      }
      & a:focus-visible {
        outline: none;
      }
    }
    .blog-cards_excerpt {
      display: none;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: var(--space-3) 0 0;
      color: var(--text-2);
      @container (width >= 24rem) {
        display: -webkit-box;
      }
    }
  }
</style>

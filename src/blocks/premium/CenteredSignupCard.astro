---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import {
  IconLayersIntersect,
  IconEye,
  IconEyeOff,
  IconLoader2,
  IconArrowRight,
  IconMail,
} from "@tabler/icons-astro";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  HTMLAttributes<"section"> & {
    /** Heading level. */
    headingTag?: "h1" | "h2" | "h3";
    /** Product name. */
    productName?: string;
    /** Sign-in destination. Omit to display a demo label. */
    signInHref?: string;
    /** Terms destination. */
    termsHref?: string;
    /** Privacy destination. */
    privacyHref?: string;
    /** Google authentication destination. Omit to disable the demo control. */
    googleHref?: string;
    /** Gmail inbox destination. Omit to disable the demo control. */
    gmailHref?: string;
    /** Outlook inbox destination. Omit to disable the demo control. */
    outlookHref?: string;
  };
const {
  render = true,
  headingTag: Title = "h2",
  productName = "Lumora",
  signInHref,
  termsHref,
  privacyHref,
  googleHref,
  gmailHref,
  outlookHref,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  class: className,
  ...rest
} = Astro.props;
const uid = `signup-${crypto.randomUUID()}`;
---

<Section
  {render}
  {theme}
  {paddingTop}
  {paddingBottom}
  class={className}
  aria-labelledby={`${uid}-title`}
  {...rest}
>
  <div class="centered-signup_wrap" data-centered-signup>
    <div class="centered-signup_left">
      <div class="centered-signup_content">
        <div data-start>
          <span class="centered-signup_mark" aria-hidden="true">
            <IconLayersIntersect size="1.3em" />
          </span>
          <Title
            id={`${uid}-title`}
            class="centered-signup_title text-style-h3"
          >
            Create your {productName} account
          </Title>
          <p class="centered-signup_intro">
            Free for three projects. No card needed.
          </p>
          <div class="centered-signup_social">
            {googleHref ? (
              <a class="centered-signup_provider" href={googleHref}>
                <svg
                  width="1.1em"
                  height="1.1em"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  />
                </svg>
                Sign up with Google
              </a>
            ) : (
              <button class="centered-signup_provider" type="button" disabled>
                <svg
                  width="1.1em"
                  height="1.1em"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  />
                </svg>
                Sign up with Google
              </button>
            )}
          </div>
          <p class="centered-signup_divider">or</p>
          <p class="centered-signup_demo">
            Interactive demo. No account is created and no email is sent. Social
            sign-in requires configured links. Use a sample password.
          </p>
          <form class="centered-signup_form" data-form>
            <fieldset class="centered-signup_fields" data-fields disabled>
              <div>
                <label class="centered-signup_label" for={`${uid}-name`}>
                  Full name
                </label>
                <input
                  class="centered-signup_input"
                  id={`${uid}-name`}
                  data-name
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  pattern=".*\S.*"
                  placeholder="Maya Ortiz"
                  aria-describedby={`${uid}-name-error`}
                />
                <p
                  class="centered-signup_hint"
                  data-name-error
                  id={`${uid}-name-error`}
                  hidden
                >
                  Enter your name.
                </p>
              </div>
              <div>
                <label class="centered-signup_label" for={`${uid}-email`}>
                  Email
                </label>
                <input
                  class="centered-signup_input"
                  id={`${uid}-email`}
                  data-email
                  type="email"
                  autocomplete="email"
                  placeholder="maya@northwind.com"
                  required
                  aria-describedby={`${uid}-hint`}
                />
                <p
                  class="centered-signup_hint"
                  id={`${uid}-hint`}
                  data-email-hint
                  aria-live="polite"
                >
                  In a live signup, we’d send a link to confirm it.
                </p>
              </div>
              <div>
                <label class="centered-signup_label" for={`${uid}-password`}>
                  Password
                </label>
                <div class="centered-signup_password">
                  <input
                    class="centered-signup_input"
                    id={`${uid}-password`}
                    data-password
                    type="password"
                    autocomplete="new-password"
                    required
                    minlength="8"
                    pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,}"
                    aria-describedby={`${uid}-rules`}
                  />
                  <button
                    class="centered-signup_toggle"
                    data-toggle
                    type="button"
                    aria-label="Show password"
                    aria-pressed="false"
                    aria-controls={`${uid}-password`}
                  >
                    <span data-eye>
                      <IconEye size="1.15em" aria-hidden="true" />
                    </span>
                    <span data-eye-off hidden>
                      <IconEyeOff size="1.15em" aria-hidden="true" />
                    </span>
                  </button>
                </div>
                <ul
                  class="centered-signup_rules"
                  id={`${uid}-rules`}
                  aria-live="polite"
                >
                  {[
                    ["length", "At least 8 characters"],
                    ["number", "At least one number"],
                    ["letter", "At least one letter"],
                  ].map(([rule, text]) => (
                    <li data-rule={rule}>
                      <span data-rule-state>○ Not yet:</span> {text}
                    </li>
                  ))}
                </ul>
              </div>
              <label class="centered-signup_news" for={`${uid}-news`}>
                <input id={`${uid}-news`} type="checkbox" name="news" />{" "}
                <span>Email me product news and tips, about once a month</span>
              </label>
              <button
                class="centered-signup_submit"
                type="submit"
                data-submit
                disabled
              >
                <span data-submit-label>Create account</span>
                <span class="centered-signup_submit-arrow">
                  <IconArrowRight size="1em" aria-hidden="true" />
                </span>
                <span class="centered-signup_spinner">
                  <IconLoader2 size="1em" aria-hidden="true" />
                </span>
              </button>
              <p class="centered-signup_hint">
                By creating an account, you agree to the{" "}
                {termsHref ? (
                  <a href={termsHref}>Terms of service</a>
                ) : (
                  "Terms of service (demo)"
                )}{" "}
                and{" "}
                {privacyHref ? (
                  <a href={privacyHref}>Privacy policy</a>
                ) : (
                  "Privacy policy (demo)"
                )}
                .
              </p>
            </fieldset>
          </form>
        </div>
        <div data-done hidden>
          <span class="centered-signup_mail">
            <IconMail size="1.5em" aria-hidden="true" />
          </span>
          <Title
            class="centered-signup_title text-style-h3"
            data-done-title
            id={`${uid}-done-title`}
            tabindex="-1"
          >
            Check your email
          </Title>
          <p class="centered-signup_intro">
            Demo confirmation for <strong data-address></strong>. In a live
            signup, you’d receive a confirmation link to finish creating your
            account. No account was created and no email was sent.
          </p>
          <div class="centered-signup_mailboxes">
            {[
              ["Open Gmail", gmailHref],
              ["Open Outlook", outlookHref],
            ].map(([label, href]) =>
              href ? (
                <a class="centered-signup_provider" href={href}>
                  {label}
                </a>
              ) : (
                <button class="centered-signup_provider" type="button" disabled>
                  {label}
                </button>
              ),
            )}
          </div>
          <div class="centered-signup_confirmation">
            <p>
              Didn’t get it? Check your spam folder, or{" "}
              <button
                class="centered-signup_text-button"
                data-resend
                type="button"
                disabled
              >
                resend the link<span data-countdown> in 0:30</span>
              </button>
              .
            </p>
            <p role="status" data-status></p>
            <button class="centered-signup_text-button" data-back type="button">
              ← Use a different email
            </button>
          </div>
        </div>
        <noscript>
          <p>
            This interactive demo requires JavaScript. No account is created.
          </p>
        </noscript>
      </div>
      <p class="centered-signup_signin">
        Already have an account?{" "}
        {signInHref ? (
          <a href={signInHref}>Sign in</a>
        ) : (
          <span>Sign in (demo)</span>
        )}
      </p>
    </div>
  </div>
</Section>

<script>
  function initCenteredSignup() {
    document
      .querySelectorAll<HTMLElement>("[data-centered-signup]")
      .forEach((root) => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";
        const get = <T extends HTMLElement>(selector: string) =>
          root.querySelector<T>(selector)!;
        const form = get<HTMLFormElement>("[data-form]");
        const email = get<HTMLInputElement>("[data-email]");
        const password = get<HTMLInputElement>("[data-password]");
        const hint = get("[data-email-hint]");
        const originalHint = hint.textContent;
        const fullName = get<HTMLInputElement>("[data-name]");
        const nameError = get("[data-name-error]");
        const submit = get<HTMLButtonElement>("[data-submit]");
        const toggle = get<HTMLButtonElement>("[data-toggle]");
        const start = get("[data-start]");
        const done = get("[data-done]");
        const resend = get<HTMLButtonElement>("[data-resend]");
        const countdown = get("[data-countdown]");
        const status = get("[data-status]");
        const rules = [...root.querySelectorAll<HTMLElement>("[data-rule]")];
        let tried = false;
        let timer: ReturnType<typeof setInterval> | undefined;
        let pending: ReturnType<typeof setTimeout> | undefined;
        const checks: Record<string, (value: string) => boolean> = {
          length: (v) => v.length >= 8,
          number: (v) => /\d/.test(v),
          letter: (v) => /[a-z]/i.test(v),
        };
        const checkRules = () => {
          rules.forEach((rule) => {
            const met = checks[rule.dataset.rule!](password.value);
            rule.dataset.state = met ? "met" : tried ? "missing" : "pending";
            rule.querySelector("[data-rule-state]")!.textContent = met
              ? "✓ Done:"
              : tried
                ? "! Missing:"
                : "○ Not yet:";
          });
          password.setAttribute(
            "aria-invalid",
            String(tried && !password.validity.valid),
          );
        };
        const showEmail = () => {
          const invalid = !email.validity.valid;
          email.setAttribute("aria-invalid", String(invalid));
          hint.textContent = invalid
            ? email.validity.valueMissing
              ? "Enter your email address."
              : "Enter an email like maya@northwind.com."
            : originalHint;
        };
        toggle.addEventListener("click", () => {
          const show = password.type === "password";
          password.type = show ? "text" : "password";
          get("[data-eye]").hidden = show;
          get("[data-eye-off]").hidden = !show;
          toggle.setAttribute("aria-pressed", String(show));
          toggle.setAttribute(
            "aria-label",
            show ? "Hide password" : "Show password",
          );
        });
        password.addEventListener("input", checkRules);
        email.addEventListener("blur", () => {
          if (email.value) showEmail();
        });
        email.addEventListener("input", () => {
          if (email.getAttribute("aria-invalid") === "true") showEmail();
        });
        fullName.addEventListener("input", () => {
          nameError.hidden = fullName.validity.valid;
          fullName.setAttribute(
            "aria-invalid",
            String(!fullName.validity.valid),
          );
        });
        let focused = false;
        form.addEventListener(
          "invalid",
          (event) => {
            event.preventDefault();
            if (event.target === fullName) {
              nameError.hidden = false;
              fullName.setAttribute("aria-invalid", "true");
            }
            if (event.target === email) showEmail();
            if (event.target === password) {
              tried = true;
              checkRules();
            }
            if (!focused) {
              focused = true;
              (event.target as HTMLElement).focus();
              setTimeout(() => {
                focused = false;
              }, 0);
            }
          },
          true,
        );
        const startCountdown = () => {
          clearInterval(timer);
          const end = Date.now() + 30000;
          resend.disabled = true;
          countdown.textContent = " in 0:30";
          timer = setInterval(() => {
            const left = Math.max(0, Math.ceil((end - Date.now()) / 1000));
            countdown.textContent = left
              ? ` in 0:${String(left).padStart(2, "0")}`
              : "";
            if (!left) {
              clearInterval(timer);
              resend.disabled = false;
            }
          }, 250);
        };
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (submit.disabled || !form.checkValidity()) return;
          const submitted = email.value.trim();
          email.readOnly = password.readOnly = fullName.readOnly = true;
          get<HTMLInputElement>('[name="news"]').disabled = true;
          submit.disabled = true;
          submit.setAttribute("aria-busy", "true");
          get("[data-submit-label]").textContent = "Creating account…";
          pending = setTimeout(() => {
            email.readOnly = password.readOnly = fullName.readOnly = false;
            get<HTMLInputElement>('[name="news"]').disabled = false;
            submit.disabled = false;
            submit.removeAttribute("aria-busy");
            get("[data-submit-label]").textContent = "Create account";
            get("[data-address]").textContent = submitted;
            password.value = "";
            tried = false;
            checkRules();
            status.textContent = "";
            start.hidden = true;
            done.hidden = false;
            root
              .closest("section")
              ?.setAttribute("aria-labelledby", get("[data-done-title]").id);
            get("[data-done-title]").focus();
            startCountdown();
          }, 900);
        });
        resend.addEventListener("click", () => {
          status.textContent =
            "Demo: a new confirmation link would be sent. No email was sent.";
          startCountdown();
        });
        get("[data-back]").addEventListener("click", () => {
          clearInterval(timer);
          done.hidden = true;
          start.hidden = false;
          root
            .closest("section")
            ?.setAttribute(
              "aria-labelledby",
              start.querySelector("h1, h2, h3")!.id,
            );
          email.focus();
          email.select();
        });
        get<HTMLFieldSetElement>("[data-fields]").disabled = false;
        submit.disabled = false;
        document.addEventListener(
          "astro:before-swap",
          () => {
            clearInterval(timer);
            clearTimeout(pending);
          },
          { once: true },
        );
      });
  }
  initCenteredSignup();
  document.addEventListener("astro:page-load", initCenteredSignup);
</script>

<style is:global>
  @layer components {
    .centered-signup_wrap {
      display: grid;
      gap: var(--space-2);
      width: 100%;
      min-width: 0;
      background: var(--background-2);
      color: var(--text);
      font-size: var(--text-small);
      line-height: 1.55;
      & [hidden] {
        display: none;
      }
      & p,
      & ul,
      & figure,
      & blockquote {
        margin: 0;
      }
      & a {
        color: inherit;
      }
      & button,
      & input {
        font: inherit;
      }
      & button {
        cursor: pointer;
      }
      & button:disabled {
        cursor: not-allowed;
        opacity: 0.6;
      }
      & :focus-visible {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
      & strong {
        overflow-wrap: anywhere;
      }
    }
    .centered-signup_left {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-2);
      min-width: 0;
    }
    .centered-signup_mark {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      margin-bottom: var(--space-5);
      border-radius: var(--radius-small);
      background: var(--text);
      color: var(--background);
    }
    .centered-signup_content {
      width: 100%;
      max-width: 25rem;
      margin: auto;
      padding: var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: calc(var(--radius-main) * 2);
      background: var(--background);
    }
    .centered-signup_title {
      margin: 0 0 var(--space-2);
    }
    .centered-signup_intro {
      color: var(--text-2);
    }
    .centered-signup_social {
      display: grid;
      gap: var(--space-2);
      margin-top: var(--space-5);
    }
    .centered-signup_provider {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-2);
      min-height: 2.75rem;
      padding: var(--space-1);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      background: var(--background-2);
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
    }
    .centered-signup_divider {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding-block: var(--space-4);
      color: var(--text-2);
      &::before,
      &::after {
        content: "";
        flex: 1;
        height: var(--border-width);
        background: var(--border);
      }
    }
    .centered-signup_demo {
      padding: var(--space-2);
      border: var(--border-width) dashed var(--border);
      border-radius: var(--radius-small);
      font-size: 0.75rem;
    }
    .centered-signup_form {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .centered-signup_fields {
      display: grid;
      gap: var(--space-3);
      border: 0;
      margin: 0;
      padding: 0;
      min-width: 0;
    }
    .centered-signup_label {
      display: block;
      font-weight: 500;
      margin-bottom: var(--space-1);
    }
    .centered-signup_input {
      display: block;
      width: 100%;
      min-height: 2.75rem;
      padding: 0.625rem 0.75rem;
      background: var(--background-2);
      color: var(--text);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      &::placeholder {
        color: var(--text-2);
      }
      &[aria-invalid="true"] {
        border-color: var(--text);
        border-width: 0.125rem;
      }
    }
    .centered-signup_password {
      position: relative;
      & input {
        padding-right: 3rem;
      }
    }
    .centered-signup_toggle {
      position: absolute;
      right: 0.25rem;
      top: 0.25rem;
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      background: transparent;
      color: var(--text-2);
      border: 0;
      border-radius: var(--radius-small);
    }
    .centered-signup_hint {
      padding-top: var(--space-1);
      color: var(--text-2);
      font-size: 0.75rem;
    }
    .centered-signup_rules {
      list-style: none;
      padding: var(--space-2) 0 0;
      font-size: 0.75rem;
      color: var(--text-2);
      & [data-state="met"] {
        color: var(--text);
      }
      & [data-state="missing"] {
        color: var(--text);
        font-weight: 700;
      }
    }
    .centered-signup_submit {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      min-height: 2.75rem;
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--radius-main);
      background: var(--button-background);
      color: var(--button-text);
      font-weight: 600;
      &:hover:enabled {
        background: var(--button-background-hover);
        color: var(--button-text-hover);
      }
    }
    .centered-signup_spinner {
      display: none;
    }
    .centered-signup_submit[aria-busy="true"] {
      & .centered-signup_submit-arrow {
        display: none;
      }
      & .centered-signup_spinner {
        display: inline-flex;
        animation: centered-signup-spin 1s linear infinite;
      }
    }
    @keyframes centered-signup-spin {
      to {
        transform: rotate(1turn);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .centered-signup_spinner {
        animation: none;
      }
    }
    .centered-signup_signin {
      text-align: center;
    }
    .centered-signup_mail {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      margin-bottom: var(--space-4);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
    }
    .centered-signup_confirmation {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-5);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--border);

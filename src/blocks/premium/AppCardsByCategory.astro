---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { IconArrowRight, IconArrowUpRight } from "@tabler/icons-astro";

type Integration = {
  name: string;
  description: string;
  href: string;
  logoPaths: string[];
  badge?: "New" | "Beta" | null;
};

type Category = {
  id: string;
  name: string;
  description: string;
  count: number;
  href: string;
  apps: Integration[];
};

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  HTMLAttributes<"section"> & {
    /** Section heading. */
    heading?: string;
    /** Introductory text. */
    description?: string;
    /** Integration categories, counts and app destinations. */
    categories?: Category[];
  };


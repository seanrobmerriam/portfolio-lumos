const {
  render = true,
  heading = "Kestrel works with the tools you already use",
  description = "Link code, designs, files and meetings to the tasks they belong to. All 50 integrations are free on every plan.",
  categories = defaultCategories,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  id = `app-categories-${crypto.randomUUID()}`,
  class: className,
  ...rest
} = Astro.props;
const visibleCategories = categories.filter(
  (category) => category.apps.length > 0,
);
---

<Section
  render={render && visibleCategories.length > 0}
  {theme}
  {paddingTop}
  {paddingBottom}
  {id}
  class={className}
  aria-labelledby={`${id}-title`}
  {...rest}
>
  <ContentWrapper>
    <p class="app-categories_eyebrow">Integrations</p>
    <Heading tag="h2" variant="h2" maxWidth={32} id={`${id}-title`}>
      {heading}
    </Heading>
    <Paragraph variant="large" maxWidth={62}>
      {description}
    </Paragraph>
  </ContentWrapper>
  <div class="app-categories_wrap">
    <nav class="app-categories_nav" aria-label="Integration categories">
      <ul class="app-categories_menu" role="list">
        {visibleCategories.map((category) => (
          <li>
            <a
              class="app-categories_category-link"
              href={`#${id}-${category.id}`}
            >
              {category.name}
              <span class="app-categories_count">{category.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="app-categories_groups">
      {visibleCategories.map((category) => (
        <section
          class="app-categories_group"
          id={`${id}-${category.id}`}
          aria-labelledby={`${id}-${category.id}-title`}
        >
          <div class="app-categories_header">
            <div>
              <h3
                class="app-categories_title text-style-h6"
                id={`${id}-${category.id}-title`}
              >
                {category.name}
              </h3>
              <p class="app-categories_description">{category.description}</p>
            </div>
            <a class="app-categories_more" href={category.href}>
              See all {category.count}
              <span class="app-categories_sr-only">
                {" "}
                {category.name.toLowerCase()} integrations
              </span>
              <IconArrowRight size="1em" stroke={1.75} aria-hidden="true" />
            </a>
          </div>
          <ul class="app-categories_cards" role="list">
            {category.apps.map((app) => (
              <li class="app-categories_item">
                <article class="app-categories_card">
                  <div class="app-categories_visual">
                    <span class="app-categories_logo">
                      <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        {app.logoPaths.map((d) => (
                          <path {d} />
                        ))}
                      </svg>
                    </span>
                    <IconArrowUpRight
                      class="app-categories_arrow"
                      size="1em"
                      stroke={1.75}
                      aria-hidden="true"
                    />
                  </div>
                  <div class="app-categories_content">
                    <h4 class="app-categories_name">
                      <a class="app-categories_app-link" href={app.href}>
                        {app.name}
                      </a>
                    </h4>
                    {app.badge && (
                      <span
                        class:list={[
                          "app-categories_badge",
                          app.badge === "New" && "new",
                        ]}
                      >
                        {app.badge}
                      </span>
                    )}
                    <p class="app-categories_description">{app.description}</p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Section>

<style is:global>
  @layer components {
    .app-categories_eyebrow {
      margin: 0;
      color: var(--text-2);
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }
    .app-categories_wrap {
      display: grid;
      gap: var(--space-5);
      width: 100%;
      min-width: 0;
      @media (width >= 64rem) {
        grid-template-columns: 13rem minmax(0, 1fr);
        gap: var(--space-6);
        & .app-categories_nav {
          position: sticky;
          top: calc(var(--nav-height) + var(--space-5));
          align-self: start;
          overflow: visible;
        }
        & .app-categories_menu {
          flex-direction: column;
          width: auto;
          gap: 0.125rem;
        }
        & .app-categories_category-link {
          justify-content: space-between;
          background-color: transparent;
          color: var(--text-2);
          &:hover {
            background-color: var(--background-2);
            color: var(--text);
          }
        }
        & .app-categories_cards {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    }
    .app-categories_nav {
      min-width: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;

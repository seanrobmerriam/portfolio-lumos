---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import { IconArrowRight, IconCheck } from "@tabler/icons-astro";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  HTMLAttributes<"section"> & {
    /** Eyebrow text. */
    eyebrow?: string;
    /** Section heading. */
    heading?: string;
    /** Introductory text. */
    description?: string;
    /** Primary action label. */
    primaryLabel?: string;
    /** Primary action destination. */
    primaryHref?: string;
    /** Secondary action label. */
    secondaryLabel?: string;
    /** Secondary action destination. */
    secondaryHref?: string;
    /** Team photo URL. */
    photoSrc?: string;
    /** Team photo alternative text. */
    photoAlt?: string;
    /** Reassurances beneath the actions. */
    reassurances?: string[];
  };

const {
  render = true,
  eyebrow = "Halcyon for teams",
  heading = "Plan the quarter together, in one afternoon",
  description = "Halcyon puts goals, projects and weekly check-ins in one shared plan, so everyone can see what matters this quarter and who is on it.",
  primaryLabel = "Get started free",
  primaryHref = "#",
  secondaryLabel = "Book a walkthrough",
  secondaryHref = "#",
  photoSrc = "https://readymadeui.com/team-image.webp",
  photoAlt = "Four colleagues laughing together around a table with a laptop, notes and small plants",
  reassurances = ["Free for up to 10 people", "Set up in 15 minutes"],
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  id = `split-photo-cta-${crypto.randomUUID()}`,
  class: className,
  ...rest
} = Astro.props;
const visibleReassurances = reassurances.filter((item) => item.trim());
---

<Section
  render={render && !!heading.trim() && !!photoSrc.trim()}
  {theme}
  {paddingTop}
  {paddingBottom}
  {id}
  class={className}
  aria-labelledby={`${id}-title`}
  {...rest}
>
  <div class="split-photo-cta_wrap">
    <div class="split-photo-cta_content">
      <ContentWrapper>
        {eyebrow.trim() && <p class="split-photo-cta_eyebrow">{eyebrow}</p>}
        <Heading tag="h2" variant="h3" id={`${id}-title`}>
          {heading}
        </Heading>
        <Paragraph variant="large" maxWidth={52}>
          {description}
        </Paragraph>
        <ButtonWrapper>
          <Button
            render={!!primaryLabel.trim() && !!primaryHref.trim()}
            element="link"
            href={primaryHref}
            class="text-style-small"
          >
            <span class="split-photo-cta_action-label">
              {primaryLabel}
              <IconArrowRight size="1em" stroke={1.75} aria-hidden="true" />
            </span>
          </Button>
          <Button
            render={!!secondaryLabel.trim() && !!secondaryHref.trim()}
            element="link"
            emphasis="secondary"
            href={secondaryHref}
            class="text-style-small"
          >
            {secondaryLabel}
          </Button>
        </ButtonWrapper>
        {visibleReassurances.length > 0 && (
          <ul class="split-photo-cta_reassurances" role="list">
            {visibleReassurances.map((item) => (
              <li class="split-photo-cta_reassurance">
                <span class="split-photo-cta_check" aria-hidden="true">
                  <IconCheck size="1em" stroke={1.75} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        )}
      </ContentWrapper>
    </div>
    <div class="split-photo-cta_photo">
      <img
        class="split-photo-cta_image"
        src={photoSrc}
        alt={photoAlt}
        width="1536"
        height="960"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</Section>

<style is:global>
  @layer components {
    .split-photo-cta_wrap {
      display: grid;
      width: 100%;
      min-width: 0;
      overflow: hidden;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      @media (width >= 30rem) {
        & .split-photo-cta_content {
          padding: var(--space-6);
        }
        & .split-photo-cta_photo {
          aspect-ratio: 2 / 1;
        }
        & .split-photo-cta_reassurances {
          flex-direction: row;
        }
      }
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        & .split-photo-cta_photo {
          aspect-ratio: auto;
          min-height: 28rem;
        }
      }
    }
    .split-photo-cta_content {
      display: flex;
      align-items: center;
      min-width: 0;
      padding: var(--space-4);
    }
    .split-photo-cta_eyebrow {
      margin: 0;
      color: var(--text-2);
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    .split-photo-cta_action-label {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
    }
    .split-photo-cta_reassurances {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      list-style: none;
      padding: 0;
      margin: var(--space-4) 0 0;
      color: var(--text-2);
      font-size: var(--text-small);
    }
    .split-photo-cta_reassurance {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    .split-photo-cta_check {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--text);
    }
    .split-photo-cta_photo {
      position: relative;
      min-width: 0;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--background-3);
    }
    .split-photo-cta_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>

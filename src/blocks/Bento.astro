---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { IconCheck } from "@tabler/icons-astro";
import { SERVICES } from "@/consts";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  Omit<astroHTML.JSX.HTMLAttributes, "color">;
const {
  render = true,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  class: className,
  ...rest
} = Astro.props;

---

<Section
  {render}
  {theme}
  {paddingTop}
  {paddingBottom}
  class={className}
  {...rest}
>
  <ContentWrapper>
    <Eyebrow>What I Do</Eyebrow>
    <Heading tag="h2" variant="h2" maxWidth={25}>
      From the first idea to the finished product
    </Heading>

  </ContentWrapper>

  <div class="bento-feature_wrap">
    {SERVICES.map((service) => (
      <article class:list={["bento-feature_tile", service.layout]}>
        <h3 class="bento-feature_title text-style-h4">
          {service.heading}
        </h3>
        <p class="bento-feature_text text-style-small">{service.text}</p>
        <div class="bento-feature_visual">
          <ul class="bento-feature_steps">
            {service.items.map((item) => (
              <li class="bento-feature_row">
                <IconCheck size="1em" stroke={1.75} aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</Section>

<style is:global>
  @layer components {
    .bento-feature_wrap {
      --_success: light-dark(#167044, #83e8af);
      --_error: light-dark(#b42332, #ff9ba5);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      width: 100%;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        & > .preview,
        & > .rollback {
          grid-column: span 2;
        }
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        & > .preview {
          grid-row: span 2;
        }
        & > .wide {
          grid-column: span 2;
        }
      }
    }
    .bento-feature_tile {
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding: var(--space-4);
      background: var(--color-white);
      border: var(--border-width) solid var(--color-black);
      border-radius: calc(var(--radius-main) * 1.5);
      color: var(--text);
      text-shadow: none;
      box-shadow: 10px 10px 2px 1px rgba(18, 18, 18, 0.2);
    }
    .bento-feature_title {
      margin: 0;
    }
    .bento-feature_text {
      margin: var(--space-2) 0 0;
      color: var(--text-2);
    }
    .bento-feature_visual {
      padding-top: var(--space-4);
      min-width: 0;
      font-size: 0.75rem;
      line-height: 1.6;
    }
    .bento-feature_panel,
    .bento-feature_raised {
      background: var(--background);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      box-shadow: 0 0.125rem 0.25rem
        color-mix(in srgb, var(--text) 4%, transparent);
    }
    .bento-feature_panel {
      padding: var(--space-3);
    }
    .bento-feature_panel.comment {
      margin-top: var(--space-3);
      margin-inline-start: var(--space-4);
    }
    .bento-feature_row,
    .bento-feature_raised,
    .bento-feature_well {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      min-width: 0;
    }
    .bento-feature_row > svg,
    .bento-feature_raised > svg {
      flex-shrink: 0;
    }
    .bento-feature_raised {
      padding: var(--space-2);
    }
    .bento-feature_raised + .bento-feature_raised {
      margin-top: var(--space-2);
    }
    .bento-feature_well {
      justify-content: space-between;
      background: var(--background-2);
      border-radius: var(--radius-small);
      padding: var(--space-2);
      margin-block: var(--space-3);
    }
    .bento-feature_mono {
      font-family: var(--font-primary);
      font-size: 0.6875rem;
      font-variant-numeric: tabular-nums;
    }
    p.bento-feature_mono {
      margin-block: var(--space-2);
      color: var(--text-2);
    }
    .bento-feature_truncate {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .bento-feature_grow {
      flex: 1;
    }
    .bento-feature_muted {
      color: var(--text-2);
    }
    .bento-feature_steps {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-block: var(--space-3);
      padding: 0;
      list-style: none;
    }
    .bento-feature_steps svg {
      color: var(--_success);
    }
    .bento-feature_status {
      flex-shrink: 0;
      color: var(--_success);
      background: color-mix(in srgb, var(--_success) 10%, var(--background));
      border: var(--border-width) solid
        color-mix(in srgb, var(--_success) 25%, transparent);
      border-radius: var(--radius-round);
      padding: 0.125rem 0.375rem;
      font-size: 0.625rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .bento-feature_status.error {
      color: var(--_error);
      background: color-mix(in srgb, var(--_error) 10%, var(--background));
      border-color: color-mix(in srgb, var(--_error) 25%, transparent);
    }
    .bento-feature_dot {
      width: 0.375rem;
      height: 0.375rem;
      flex-shrink: 0;
      border-radius: var(--radius-round);
      background: var(--_success);
    }
    .bento-feature_dot.error {
      background: var(--_error);
    }
    .bento-feature_chip {
      flex-shrink: 0;
      border: var(--border-width) solid var(--border);
      padding: 0.125rem 0.375rem;
      border-radius: var(--radius-small);
      white-space: nowrap;
    }
    .bento-feature_avatars {
      display: flex;
      padding-inline-end: 0.375rem;
    }
    .bento-feature_avatar,
    .bento-feature_avatars > span {
      display: inline-grid;
      place-items: center;
      flex-shrink: 0;
      width: 2em;
      height: 2em;
      background: var(--background-3);
      border: var(--border-width) solid var(--background);
      border-radius: var(--radius-round);
      font-size: 0.625rem;
    }
    .bento-feature_avatars > span + span {
      margin-inline-start: -0.375rem;
    }
    .bento-feature_comment {
      margin: var(--space-2) 0 0;
    }
    .bento-feature_visual.regions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
    }
    .bento-feature_visual.regions > .bento-feature_raised {
      margin: 0;
    }
    .bento-feature_logs {
      margin-top: var(--space-3);
      color: var(--text-2);
      overflow-wrap: anywhere;
    }
    .bento-feature_error {
      color: var(--_error);
    }
    .bento-feature_usage {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-1);
      font-variant-numeric: tabular-nums;
    }
    .bento-feature_meter {
      height: 0.375rem;
      border-radius: var(--radius-round);
      background: var(--background-2);
      overflow: hidden;
      margin-block: var(--space-3);
    }
    .bento-feature_meter > span {
      display: block;
      width: 74%;
      height: 100%;
      background: var(--text);
      border-radius: inherit;
    }
    .bento-feature_caption {
      margin: 0;
      color: var(--text-2);
      font-size: 0.6875rem;
    }
  }

  .bento-box-shadow {
    box-shadow: 12px 12px 2px 1px rgb(0 0 255 / 0.2);
  }

</style>


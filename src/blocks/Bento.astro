---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { IconCheck } from "@tabler/icons-astro";
import { SERVICES } from "@/consts";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  Omit<astroHTML.JSX.HTMLAttributes, "color">;
const {
  render = true,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  class: className,
  ...rest
} = Astro.props;
---

<Section
  {render}
  {theme}
  {paddingTop}
  {paddingBottom}
  class={className}
  {...rest}
>
  <ContentWrapper>
    <Heading tag="h2" class="heading-label">what i do</Heading>
    <Paragraph variant="h4" maxWidth={44} class="font-figtree margin-top-6">
      Design, engineering and the work in between, handled by one person from
      the first idea to the finished product.
    </Paragraph>
  </ContentWrapper>

  <div class="bento-feature_wrap">
    {SERVICES.map((service) => (
      <article class="bento-feature_tile">
        <h3 class="bento-feature_title text-style-h4">{service.heading}</h3>
        <p class="bento-feature_text text-style-small">{service.text}</p>
        <ul class="bento-feature_steps text-style-small">
          {service.items.map((item) => (
            <li class="bento-feature_row">
              <IconCheck size="1em" stroke={1.75} aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</Section>

<style is:global>
  @layer components {
    .bento-feature_wrap {
      --_success: light-dark(#167044, #83e8af);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      width: 100%;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    .bento-feature_tile {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 3;
      row-gap: 0;
      min-width: 0;
      padding: var(--space-5);
      background: var(--color-white);
      border: var(--border-width) solid var(--color-black);
      border-radius: calc(var(--radius-main) * 1.5);
      color: var(--text);
      box-shadow: 10px 10px 2px 1px rgba(18, 18, 18, 0.2);
    }
    .bento-feature_title {
      margin: 0;
    }
    .bento-feature_text {
      margin: var(--space-3) 0 var(--space-5);
      color: var(--text-2);
    }
    .bento-feature_steps {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      align-self: start;
      margin: 0;
      padding: var(--space-4) 0 0;
      border-top: var(--border-width) solid var(--border);
      list-style: none;
    }
    .bento-feature_row {
      display: flex;
      align-items: start;
      gap: var(--space-2);
      min-width: 0;
      & > svg {
        flex-shrink: 0;
        margin-top: 0.3em;
        color: var(--_success);
      }
    }
  }
</style>

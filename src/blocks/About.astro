---
import NoteHandwritten from "@/components/content/NoteHandwritten.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

const TOOLS = [
  "Rust",
  "Erlang",
  "TypeScript",
  "Go",
  "WebAssembly",
  "Astro",
  "React",
  "PostgreSQL",
  "Docker",
];
---

<Section id="about">
  <ContentWrapper>
    <Heading tag="h2" class="heading-label">a little about me</Heading>
  </ContentWrapper>
  <ContentWrapper variant="columns">
    <NoteHandwritten
      slot="column2"
      text="The person designing it is the person building it."
    />
    <div class="about_tile about_tools" slot="column2">
      <h3 class="about_title text-style-h5">Tools I reach for</h3>
      <ul class="about_list text-style-small">
        {TOOLS.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="about_tile">
      <Paragraph variant="main" class="margin-bottom-2">
        I’m Sean. I design and build digital products: content-heavy websites,
        fast web applications and native, local-first software in Rust and
        Erlang.
      </Paragraph>
      <Paragraph variant="large">
        I started out in software engineering and kept getting pulled toward
        the details that make a product feel finished: how the content reads,
        how an interaction responds, how easily the whole thing can grow.
        That’s how I ended up a design engineer.
      </Paragraph>
      <Paragraph variant="large">
        I don’t hand a design off to a separate team; I build it myself. That
        can take a little longer up front, but less gets lost in translation,
        and the result holds together and stays easy to maintain.
      </Paragraph>
      <Paragraph variant="large">
        I can help shape an early idea, carry a design through development or
        join your team where you need an extra pair of hands.
      </Paragraph>
    </div>
  </ContentWrapper>
</Section>

<style is:global>
  @layer components {
    .about_tile {
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding: var(--space-5);
      background: var(--color-white);
      border: var(--border-width) solid var(--color-black);
      border-radius: calc(var(--radius-main) * 1.5);
      color: var(--text);
      box-shadow: 10px 10px 2px 1px rgba(18, 18, 18, 0.2);
      &.about_tools {
        margin-top: var(--space-6);
      }
    }
    .about_title {
      margin: 0;
    }
    .about_list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin: var(--space-3) 0 0;
      padding: 0;
      list-style: none;
      color: var(--text-2);
      & li {
        padding: 0.15em 0.65em;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-round);
      }
    }
  }
</style>

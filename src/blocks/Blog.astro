---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import { IconArrowRight } from "@tabler/icons-astro";

import { getPublishedPosts, postCard } from "@/utils/blog";

interface Post {
  title: string;
  href: string;
  category: string;
  date: string;
  dateLabel: string;
  excerpt: string;
  image: string;
  imageAlt: string;
  author: string;
  authorImage?: string | null;
  initials?: string;
  readTime: string;
}

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> &
  HTMLAttributes<"section"> & {
    /** Journal posts. */
    posts?: Post[];
    /** All articles destination. */
    allArticlesHref?: string;
  };
const {
  render = true,
  posts = (await getPublishedPosts()).map(postCard),
  allArticlesHref = "/blog/",
  theme = "inherit",
  paddingTop = "large",
  paddingBottom = "large",
  id = `post-list-thumbnails-${crypto.randomUUID()}`,
  class: className,
  ...rest
} = Astro.props;
const titleId = `${id}-title`;
const visiblePosts: Post[] = posts.filter(
  (post) => post.title.trim() && post.href.trim(),
);
---

<Section
  render={render && visiblePosts.length > 0}
  {theme}
  {paddingTop}
  {paddingBottom}
  {id}
  aria-labelledby={titleId}
  class={className}
  {...rest}
>
  <div class="post-thumbnails_wrap">
    <header class="post-thumbnails_intro">
      <ContentWrapper>
        <Eyebrow>Journal</Eyebrow>
      <Heading tag="h2" class="radius-small background-yellow angled-text-right-2 emphasis font-quicksand padding-inline-2 padding-block-2 margin-top-3 text-wrap-nowrap drop-shadow-text">
        writing & notes
      </Heading>
        <Paragraph variant="large" maxWidth={42}>
          Ideas, process and lessons from designing and building digital products.
        </Paragraph>
        <a class="post-thumbnails_all text-style-small" href={allArticlesHref}>
          All articles
          <IconArrowRight size="1em" stroke={1.75} aria-hidden="true" />
        </a>
      </ContentWrapper>
    </header>
    <ul class="post-thumbnails_list" role="list">
      {visiblePosts.map((post) => (
        <li class="post-thumbnails_item">
          <article class="post-thumbnails_article">
            {post.image && <div class="post-thumbnails_media">
              <img
                class="post-thumbnails_image"
                src={post.image}
                alt={post.imageAlt}
                width="672"
                height="448"
                loading="lazy"
                decoding="async"
              />
            </div>}
            <div class="post-thumbnails_content">
              <p class="post-thumbnails_meta text-style-small">
                <span class="post-thumbnails_category">{post.category}</span> ·{" "}
                <time datetime={post.date}>{post.dateLabel}</time>
              </p>
              <h3 class="post-thumbnails_title text-style-h6">
                <a class="post-thumbnails_link" href={post.href}>
                  {post.title}
                </a>
              </h3>
              <p class="post-thumbnails_excerpt text-style-small">
                {post.excerpt}
              </p>
              <div class="post-thumbnails_author text-style-small">
                {post.authorImage ? (
                  <img
                    class="post-thumbnails_avatar"
                    src={post.authorImage}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span
                    class="post-thumbnails_avatar initials"
                    aria-hidden="true"
                  >
                    {post.initials ||
                      post.author
                        .split(/\s+/)
                        .map((name) => name[0])
                        .join("")
                        .slice(0, 2)}
                  </span>
                )}
                <span class="post-thumbnails_name">{post.author}</span>
                <span aria-hidden="true">·</span>
                <span class="post-thumbnails_read-time">{post.readTime}</span>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style is:global>
  @layer components {
    .post-thumbnails_wrap {
      display: grid;
      width: 100%;
      gap: var(--space-8);
      align-items: start;

      @media (width >= 30rem) {
        & .post-thumbnails_media {
          width: 12rem;
        }
        & .post-thumbnails_article {
          gap: var(--space-4);
        }
        & .post-thumbnails_excerpt {
          display: -webkit-box;
        }
        & .post-thumbnails_item {
          padding-block: var(--space-5);
        }
      }
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        & .post-thumbnails_intro {
          position: sticky;
          top: calc(var(--nav-height) + var(--space-5));
        }
        & .post-thumbnails_media {
          width: 14rem;
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        & .post-thumbnails_image {
          transition: transform var(--hover-duration) var(--hover-ease);
        }
        & .post-thumbnails_article:hover .post-thumbnails_image {
          transform: scale(1.05);
        }
        & .post-thumbnails_all svg {
          transition: transform var(--hover-duration) var(--hover-ease);
        }
        & .post-thumbnails_all:hover svg {
          transform: translateX(0.125em);
        }
      }
    }
    .post-thumbnails_intro {
      min-width: 0;
    }
    .post-thumbnails_all {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      color: var(--link-text);
      font-weight: var(--primary-medium);
      text-decoration: none;
      margin-top: var(--space-3);
      border-radius: var(--radius-small);
      &:hover {
        text-decoration: underline;
      }
    }
    .post-thumbnails_list {
      min-width: 0;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .post-thumbnails_item {
      padding-block: var(--space-4);
      & + & {
        border-top: var(--border-width) solid var(--border);
      }
      &:first-child {
        padding-top: 0;
      }
      &:last-child {
        padding-bottom: 0;
      }
    }
    .post-thumbnails_article {
      position: relative;
      display: flex;
      align-items: start;
      gap: var(--space-3);
      border-radius: var(--radius-main);
      &:has(.post-thumbnails_link:focus-visible) {
        outline: var(--focus-width) solid var(--link-text);
        outline-offset: var(--space-1);
      }
      &:hover .post-thumbnails_title {
        text-decoration: underline;
      }
    }
    .post-thumbnails_media {
      flex-shrink: 0;
      width: 7rem;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: var(--radius-main);
      background: var(--background-2);
      border: var(--border-width) solid var(--border);
    }
    .post-thumbnails_image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .post-thumbnails_content {
      flex: 1;
      min-width: 0;
    }
    .post-thumbnails_meta {
      margin: 0;
      color: var(--text-2);
    }
    .post-thumbnails_category {
      color: var(--text);
      font-weight: var(--primary-medium);
    }
    .post-thumbnails_title {
      margin: var(--space-1) 0 0;
      text-decoration-color: var(--border);
      text-underline-offset: 0.2em;
    }
    .post-thumbnails_link {
      color: var(--text);
      text-decoration: none;
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
      }
      &:focus-visible {
        outline: none;
      }
    }
    .post-thumbnails_excerpt {
      display: none;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: var(--space-2) 0 0;
      color: var(--text-2);
    }
    .post-thumbnails_author {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-top: var(--space-2);
      color: var(--text-2);
    }
    .post-thumbnails_avatar {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-shrink: 0;
      width: 1.5rem;
      height: 1.5rem;
      object-fit: cover;
      border-radius: var(--radius-round);
      background: var(--background-2);
      color: var(--text);
      &.initials {
        font-size: 0.6875rem;
        font-weight: var(--primary-medium);
      }
    }
    .post-thumbnails_name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .post-thumbnails_read-time {
      white-space: nowrap;
    }
  }
</style>

---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
  /** Font family. Leave unset to keep the default text style. */
  fontFamily?: "primary" | "display" | "heading";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  fontFamily,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={[
      "eyebrow_wrap",
      variant !== "default" && variant,
      fontFamily && `font-${fontFamily}`,
      className,
    ]}
    {...rest}
  >
    {variant === "default" && (
      <span class="eyebrow_marker" aria-hidden="true" />
    )}
    <Tag class="eyebrow_text text-style-large">
      <Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
        font-size: var(--font-size-large);
      }
      &.font-primary .eyebrow_text {
        font-family: var(--primary-family);
      }
      &.font-display .eyebrow_text {
        font-family: var(--display-family);
      }
      &.font-heading .eyebrow_text {
        font-family: var(--heading-family);
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>

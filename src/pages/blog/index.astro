---
import Layout from "@/layouts/BaseLayout.astro";
import Blog from "@/blocks/Blog.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { getPublishedPosts, postCard } from "@/utils/blog";
const posts = (await getPublishedPosts()).map(postCard);
---

<Layout title="Journal" description="Notes on design, development and building digital products.">
  {posts.length ? <Blog posts={posts} /> : (
    <Section>
      <Heading tag="h1">Journal</Heading>
      <Paragraph>New articles are on their way.</Paragraph>
    </Section>
  )}
</Layout>

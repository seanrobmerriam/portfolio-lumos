  }

  .font-luckiest-guy {
    font-family: "Luckiest Guy";
  }

  .font-dosis {
    font-family: "Dosis Variable";
  }

  .font-fredoka {
    font-family: "Fredoka Variable";
  }

  .font-urbanist {
    font-family: "Urbanist Variable";

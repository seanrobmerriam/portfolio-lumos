---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import lumos_background from "@/assets/graphics/lumos-background.svg";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Card from "@/components/item/Card.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Slider from "@/components/interactive/Slider.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import { NEON_FUNCTION_CONTACT_BASE_URL } from "astro:env/server";
import IconCopyright from "@tabler/icons/outline/copyright.svg";
import IconLayoutDashboard from "@tabler/icons/outline/layout-dashboard.svg";
import IconGitPullRequestLockedAi from "@tabler/icons/outline/git-pull-request-locked-ai.svg";
import IconDatabase from "@tabler/icons/outline/database.svg";
import IconAiAgents from "@tabler/icons/outline/ai-agents.svg";
import IconBrandWordpress from "@tabler/icons/outline/brand-wordpress.svg";
import Modal from "@/components/interactive/Modal.astro";

const sectionLabelClass =
  "angled-text-right-1 emphasis font-figtree padding-inline-2 padding-block-3 margin-top-3 text-wrap-nowrap";

const process = [
  {
    heading: "Design",
    text: "We start with the people using your product and what they need to get done. I explore the structure, content and visual direction, then turn those ideas into screens we can discuss and refine.",
  },
  {
    heading: "Planning",
    text: "Together, we decide what belongs in the first release and what can wait. I map out the pages, features and integrations, flag dependencies early and break the work into clear milestones.",
  },
  {
    heading: "Development",
    text: "I bring the design into the browser, build reusable components and connect the systems behind them. You can review the work as it takes shape, so we can make decisions with a working product in front of us.",
  },
  {
    heading: "Testing",
    text: "Before launch, I check the details that make a site work in everyday use: small screens, keyboard navigation, forms, loading speed and error states. We work through the rough edges before handing it over.",
  },
  {
    heading: "Ongoing care",
    text: "After launch, the site needs room to grow. I can help with fixes, updates and new features, using the same components and design rules to keep each addition consistent.",
  },
];

const services = [
  {
    heading: "Brand Systems",
    text: "Turn your visual identity into practical rules for type, color and components that your team can use across the site.",
    icon: IconCopyright,
  },
  {
    heading: "Web Design",
    text: "Give your content a clear structure and a distinctive look, with layouts that work from a phone to a wide screen.",
    icon: IconLayoutDashboard,
  },
  {
    heading: "Development",
    text: "Build your site with Astro, reusable components and plain CSS, with attention to speed, accessibility and future updates.",
    icon: IconGitPullRequestLockedAi,
  },
  {
    heading: "AI Integrations",
    text: "Add AI where it serves a clear purpose, from helping people find information to reducing repetitive work.",
    icon: IconDatabase,
  },
  {
    heading: "Agent workflows",
    text: "Set up coding agents with project instructions and checks that help them contribute to your existing development workflow.",
    icon: IconAiAgents,
  },
  {
    heading: "Site migrations",
    text: "Move from Webflow, WordPress or another platform to Astro, with a plan for your content, redirects and editing needs.",
    icon: IconBrandWordpress,
  },
];

const faqs = [
  {
    heading: "What kinds of projects do you take on?",
    text: "I work on brand systems, websites and web applications. That can mean shaping a landing page, building a product interface or bringing an existing site into a more maintainable system.",
  },
  {
    heading: "What do you build with?",
    text: "For websites, I use Astro with reusable components and plain CSS. The tools for the rest of a project depend on its content, features and the systems your team already uses.",
  },
  {
    heading: "Can you move my site off its current CMS?",
    text: "Yes. We first review your content, URLs and publishing needs, then plan the move to Astro. That includes deciding what to keep, where redirects are needed and how your team will make updates.",
  },
  {
    heading: "How do AI and agents fit into a project?",
    text: "We start with a specific task worth improving. I can build AI features into a product or set up agents to assist with development, with review and checks suited to the work.",
  },
  {
    heading: "Will my team be able to update the site?",
    text: "We choose an editing setup around your team. Developers can work with documented components; if you need to publish without touching code, we can scope a CMS into the project.",
  },
  {
    heading: "How do we get started?",
    text: "Use the form below to tell me what you have in mind, where things stand and what you need help with. A rough brief is enough to start the conversation.",
  },
];

const workImages = import.meta.glob<{ default: ImageMetadata }>(
  "@/assets/images/work/*.webp",
  { eager: true },
);

const work = [
  {
    slug: "admin-dashboard",
    eyebrow: "Dashboard",
    heading: "Controlplane — admin console",
    text: "Keep track of a platform in one place. Tenant metrics, request volume, service health and queued jobs give administrators a view of what needs attention.",
    imageAlt:
      "Controlplane admin console showing metric cards, a request-volume bar chart and a service-health list",
  },
  {
    slug: "accessibility-settings-page",
    eyebrow: "Accessibility",
    heading: "Common Ground — accessibility settings",
    text: "Put reading preferences within reach. A live preview shows how text size, contrast, motion and focus settings change the experience.",
    imageAlt:
      "Common Ground settings page with a live reading preview beside text size, contrast, motion and focus options",
  },
  {
    slug: "automation-workflow-builder",
    eyebrow: "Product UI",
    heading: "Threadwork — workflow builder",
    text: "Make an automation easier to follow. Finance teams can connect triggers, conditions and actions, then open each step to configure its behavior.",
    imageAlt:
      "Threadwork workflow canvas with schedule, filter and email steps and a node configuration panel",
  },
  {
    slug: "analytics-dashboard",
    eyebrow: "Analytics",
    heading: "fieldnotes — growth report",
    text: "Follow the path from first visit to product value. Trends, activation metrics and audience segments bring different parts of the growth story together.",
    imageAlt:
      "fieldnotes growth report with an active-teams bar chart, key metrics and a segment table",
  },
  {
    slug: "admin-data-table",
    eyebrow: "Data table",
    heading: "assembly — people directory",
    text: "Help workspace admins handle everyday people management. Search, filters, role controls and bulk actions keep a busy directory easy to navigate.",
    imageAlt:
      "assembly people table with status tabs, a search field, role dropdowns and status badges",
  },
  {
    slug: "audit-log",
    eyebrow: "Compliance",
    heading: "Recordkeeper — audit ledger",
    text: "Trace a change back to its source. Searchable events and a detail panel bring the actor, origin and record of each change into view.",
    imageAlt:
      "Recordkeeper audit ledger listing events with an evidence inspector panel",
  },
  {
    slug: "api-playground",
    eyebrow: "Developer tools",
    heading: "Request Lab — API playground",
    text: "Explore an API request from input to response. An editable payload, headers and validation feedback make it easier to see how the pieces fit.",
    imageAlt:
      "Request Lab playground with a POST request, JSON payload editor and response panel",
  },
  {
    slug: "api-reference",
    eyebrow: "Docs",
    heading: "Northstar — API reference",
    text: "Give developers a clear route to their first request. Grouped endpoints, authentication guidance and example responses sit alongside the reference material.",
    imageAlt:
      "Northstar API reference with an endpoint sidebar, the List projects page and an example cURL request",
  },
  {
    slug: "cms-content-editor",
    eyebrow: "CMS",
    heading: "Folio — story editor",
    text: "Keep the writing and publishing tasks together. Article fields, a content library and publication settings support the journey from draft to published story.",
    imageAlt:
      "Folio story editor with a content library, article fields and a publication settings panel",
  },
  {
    slug: "ai-product-landing",
    eyebrow: "Landing page",
    heading: "Claimwell — AI product landing",
    text: "Explain an AI claims product through the work it supports. A sample review brings evidence and policy checks into the story, with the final decision left to a person.",
    imageAlt:
      "Claimwell landing page headline beside a claim review card with evidence and policy checks",
  },
  {
    slug: "business-landing-page",
    eyebrow: "Landing page",
    heading: "Routeline — business landing",
    text: "Show field-service teams how a working day could run. A sample schedule connects the product’s scheduling, customer updates and invoicing features.",
    imageAlt:
      "Routeline landing page with a “Less chasing. More doing.” headline and a sample day schedule card",
  },
  {
    slug: "agency-services-landing",
    eyebrow: "Agency",
    heading: "Good Form — studio site",
    text: "Introduce a studio through its point of view and visual work. Bold typography, a concise introduction and a partnership grid carry the story.",
    imageAlt:
      "Good Form studio homepage with a “Your next chapter. Better told.” headline and a stats band",
  },
  {
    slug: "about-company-page",
    eyebrow: "Company",
    heading: "Northstar — about page",
    text: "Give a company story a clear thread. A founding-year feature, timeline and team section connect its beginnings with the people building it today.",
    imageAlt:
      "Northstar about page with a large headline and a green 2018 field-notes card",
  },
  {
    slug: "app-store-listing-page",
    eyebrow: "App listing",
    heading: "Orbit — app store listing",
    text: "Introduce a focus app with a little breathing room. A timer preview, weekly activity and privacy information help visitors understand the experience.",
    imageAlt:
      "Orbit app listing with a “A little space to focus” headline, a 25:00 focus timer and a weekly total card",
  },
];
---

<Layout
  theme="dark"
  image="url('data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='0.35'%3E%3Cpath d='M50 50c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10s-10-4.477-10-10 4.477-10 10-10zM10 10c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10S0 25.523 0 20s4.477-10 10-10zm10 8c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm40 40c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8z' /%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
  overlap
>
  <!-- hero -->
  <Section paddingBottom="small" paddingTop="large" gap="4" fullHeight="true">
    <ContentWrapper>
      <Eyebrow tag="span" class="eyebrow_marker font-figtree">
        Sean Merriam
      </Eyebrow>
      <Heading
        variant="display"
        tag="h1"
        class="margin-top-8 font-bowlby-one-sc flex-grow"
      >
        Design Engineer
      </Heading>
    </ContentWrapper>
    <div class="flex-horizontal-nowrap align-items-start gap-4">
      <Heading
        variant="h3"
        tag="h2"
        class="particle font-figtree flex-noshrink"
      >
        noun
      </Heading>
      <Heading maxWidth={60} variant="h4" tag="h3" class="font-figtree">
        A person who combines both{" "}
        <span class="emphasis padding-inline-1 angled-text-left-1">design</span>{" "}
        and{" "}
        <span class="emphasis padding-inline-1 angled-text-right-1">
          engineering
        </span>{" "}
        skills to create cohesive and functional digital experiences.
      </Heading>
    </div>
  </Section>

  <!-- about -->
  <Section id="about" fullHeight="true">
    <Heading tag="h2" class={sectionLabelClass}>a little about me</Heading>
    <Paragraph variant="h4" class="font-figtree">
      I’m Sean. I help teams take a website or product from the first
      sketch to a working experience in the browser.
    </Paragraph>
    <Paragraph class="font-figtree">
      My work connects the visual details with the code behind them: how a page
      reads, how an interaction feels and how easily your team can build on it.
      I can help shape the idea, carry it through development or join where
      you need an extra pair of hands.
    </Paragraph>
  </Section>

  <!-- process -->
  <Section id="process" fullHeight="true">
    <Heading tag="h2" class={sectionLabelClass}>how we’ll work</Heading>
    <Paragraph variant="h4" class="font-figtree">
      A clear direction, work you can review along the way and care for the
      details before launch.
    </Paragraph>
    {process.map((step) => (
      <Grid medium={2}>
        <Heading
          tag="h3"
          variant="h3"
          maxWidth={17}
          class="font-fredoka margin-top-1 padding-3"
        >
          {step.heading}
        </Heading>
        <Paragraph maxWidth={40} class="font-figtree padding-top-8">
          {step.text}
        </Paragraph>
      </Grid>
    ))}
  </Section>

  <!-- services -->
  <Section id="services" fullHeight="true">
    <Heading tag="h2" class={sectionLabelClass}>where I can help</Heading>
    <Paragraph variant="h4" class="font-figtree">
      From a new visual direction to the systems that keep your site running.
    </Paragraph>
    <Grid medium={3}>
      {services.map((service) => (
        <Card {...service} />
      ))}
    </Grid>
  </Section>

  <!-- recent work -->
  <Section id="work" fullHeight="true">
    <Heading tag="h2" class={sectionLabelClass}>selected work</Heading>
    <Paragraph variant="h4" class="font-figtree">
      A selection of interfaces, from everyday admin tools to websites that
      introduce a product to the world.
    </Paragraph>
    <Slider
      variant="contained"
      label="Selected projects"
      small={1.5}
      medium={2}
      large={3}
    >
      {work.map(({ slug, ...project }) => (
        <Card
          {...project}
          variant="stacked"
          image={
            workImages[`/src/assets/images/work/${slug}.webp`]?.default ??
            lumos_background
          }
          buttonLabel="Explore project"
          buttonHref={`https://work.seanmerriam.com/${slug}/`}
        />
      ))}
    </Slider>
  </Section>

  <!-- faq -->
  <Section id="faq" fullHeight="true">
    <Heading tag="h2" class={sectionLabelClass}>before we start</Heading>
    <Paragraph variant="h4" class="font-figtree">
      A few things you might want to know before we work together.
    </Paragraph>
    <Accordion openFirst={false} class="width-full">
      {faqs.map((faq) => (
        <AccordionItem heading={faq.heading}>
          <Paragraph maxWidth={48}>{faq.text}</Paragraph>
        </AccordionItem>
      ))}
    </Accordion>
  </Section>

  <!-- contact -->
  <Section id="contact">
    <Heading tag="h2" class={sectionLabelClass}>let’s talk</Heading>
    <Paragraph variant="h4" class="font-figtree">
      Have something in mind? Let’s work out what it needs.
    </Paragraph>
    <Paragraph maxWidth={50}>
      Tell me what you’re building, what’s getting in the way and any timing
      you’re working toward. Links and rough ideas are welcome.
    </Paragraph>
    <Form
      name="contact"
      action={NEON_FUNCTION_CONTACT_BASE_URL}
      class="width-full"
    >
      <Fieldset legend="Your details" legendStyle="hidden">
        <Grid medium={2}>
          <Input variant="first-name" name="first_name" required />
          <Input variant="last-name" name="last_name" required />
        </Grid>
        <Input
          variant="email"
          name="email"
          label="Your email"
          placeholder="you@company.com"
          required
        />
        <Textarea
          label="About your project"
          name="message"
          placeholder="What are you working on, and where could I help?"
          required
        />
      </Fieldset>
      <ButtonWrapper marginTop="4">
        <Button type="submit">Send your message</Button>
      </ButtonWrapper>
    </Form>
  </Section>

  <Section id="quick-contact">
    <Button data-modal-open="wterm">Start a conversation</Button>
    <Modal id="wterm" label="Contact Sean" variant="bottom-sheet" shortcut="`">
      <Form action="/api/contact">
        <Input variant="email" required />
        <Button type="submit">Send email address</Button>
      </Form>
    </Modal>
  </Section>
</Layout>


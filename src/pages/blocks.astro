---
import Layout from "@/layouts/BaseLayout.astro";
import HeroBlock from "@/blocks/premium/HeroBlock.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Img from "@/components/media/Img.astro";
import phone from "@/assets/graphics/phone.svg";
import Icon from "@/components/media/Icon.astro";
import logo_icon from "@/assets/logo/logo-icon.svg";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import BentoFeature from "@/blocks/premium/BentoFeature.astro";
import { 
  IconLockCheck,
  IconTool,
  IconHttpGet,
  IconBinary,
 } from "@tabler/icons-astro";
import InstallTerm from "@/blocks/premium/InstallTerm.astro";
import BrowserDemo from "@/components/content/BrowserDemo.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import WaitlistFeature from "@/blocks/premium/WaitlistFeature.astro";
import CenteredProductHero from "@/blocks/premium/CenteredProductHero.astro";
import TextOnlyHero from "@/blocks/premium/TextOnlyHero.astro";
import ThreePlanPricing from "@/blocks/premium/ThreePlanPricing.astro";
import SinglePlanPricing from "@/blocks/premium/SinglePlanPricing.astro";
import SplitScreenSignup from "@/blocks/premium/SplitScreenSignup.astro";
import NewsletterCard from "@/blocks/premium/NewsletterCard.astro";
import PostListThumbnails from "@/blocks/premium/PostListThumbnails.astro";
import TwoColumnFaq from "@/blocks/premium/TwoColumnFaq.astro";
import ShopByActivity from "@/blocks/premium/ShopByActivity.astro";
import AppCardsByCategory from "@/blocks/premium/AppCardsByCategory.astro";
import PromoCodeBar from "@/blocks/premium/PromoCodeBar.astro";
import SimpleContactForm from "@/blocks/premium/SimpleContactForm.astro";
import IconFeatureColumns from "@/blocks/premium/IconFeatureColumns.astro";
import SplitPhotoCta from "@/blocks/premium/SplitPhotoCta.astro";
import CenteredSignupCard from "@/blocks/premium/CenteredSignupCard.astro";
import InlineNewsletterSignup from "@/blocks/premium/InlineNewsletterSignup.astro";
import HairlineStatsStrip from "@/blocks/premium/HairlineStatsStrip.astro";
import SplitTextPhoto from "@/blocks/premium/SplitTextPhoto.astro";
import LongFormArticle from "@/blocks/premium/LongFormArticle.astro";
---

<Layout theme="dark">
  <PromoCodeBar slot="announcement" dismissFocusTarget=".nav_logo" />
  <HeroBlock />
  <hr>
  <InstallTerm id="installation" />
  <hr>
  <BentoFeature id="platform-features" />
  <Section>
    <ContentWrapper centered>
      <Eyebrow>From code to canvas</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>A little code. A world of possibilities.</Heading>
      <Paragraph variant="large" maxWidth={54}>Bring your ideas to life with HTML and CSS. Your next page starts with a blank canvas and a browser.</Paragraph>
    </ContentWrapper>
    <BrowserDemo />
  </Section>
  <WaitlistFeature />
  <CenteredProductHero headingTag="h2" ratingText="Example rating: 4.8 out of 5 from 1,900 support teams" />
  <TextOnlyHero headingTag="h2" customersHeading="Example customer wordmarks" />
  <ThreePlanPricing id="pricing" />
  <SinglePlanPricing id="single-plan-pricing" />
  <SplitScreenSignup id="signup" />
  <NewsletterCard id="newsletter" />
  <PostListThumbnails id="journal" />
  <TwoColumnFaq id="faq" />
  <ShopByActivity id="shop-by-activity" />
  <AppCardsByCategory id="integrations" />
  <IconFeatureColumns id="icon-features" />
  <SplitPhotoCta id="team-cta" />
  <SimpleContactForm id="contact" />
  <CenteredSignupCard id="centered-signup" />
  <InlineNewsletterSignup id="inline-newsletter" />
  <HairlineStatsStrip id="stats" />
  <SplitTextPhoto id="about-atrium" />
  <LongFormArticle id="company-article" />
</Layout>
